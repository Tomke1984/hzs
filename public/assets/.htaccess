# CSS en JS: altijd even navragen (304 als er niets veranderde), zodat na een update nooit oude JavaScript met
# nieuwe pagina's samenloopt, ook niet achter een proxy die de ?v= in het adres negeert. Het logo mag een jaar in de cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.png$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
