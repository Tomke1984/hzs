# Webserver voor Coolify/Railpack (FrankenPHP = Caddy + PHP). Railpack gebruikt dit bestand in plaats van zijn
# standaardconfiguratie, die de hele projectmap (/app) zou uitleveren, inclusief storage/ met de database.
# Lokaal en op Apache-hosting wordt dit bestand niet gebruikt (daar gelden de .htaccess-bestanden).
{
	admin off
	persist_config off
	auto_https off

	{$CADDY_GLOBAL_OPTIONS}

	log {
		format json
		output stderr
		level INFO
	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

:{$PORT:80} {
	# Enkel public/ is bereikbaar; app/, storage/ (database, sleutel, back-ups), config.php, ... nooit.
	root * {$HZS_PUBLIC_DIR:/app/public}

	encode zstd br gzip

	# Verborgen bestanden (.htaccess, .git, ...) nooit uitleveren
	@hidden path */.*
	respond @hidden 404

	# CSS en JS: altijd even navragen (304 als er niets veranderde), zodat na een deploy nooit oude JavaScript
	# met nieuwe pagina's samenloopt, ook niet achter een proxy of cache die de ?v= in het adres negeert.
	# Het logo mag een jaar in de cache.
	@code path /assets/*.css /assets/*.js
	header @code Cache-Control "no-cache"
	@img path /assets/*.png
	header @img Cache-Control "public, max-age=31536000, immutable"

	header {
		-Server
		-X-Powered-By
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Bestaand bestand uitleveren, anders alles via public/index.php (leesbare adressen zoals /aanmelden)
	php_server
}
